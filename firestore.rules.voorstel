// VOORSTEL — nog niet actief.
//
// Dit bestand is bewust géén firestore.rules, omdat het pas werkt als er echte
// authenticatie in de app zit (zie BEVEILIGING.md). Neem het door, en hernoem het
// naar firestore.rules zodra de keuze over inloggen is gemaakt en Firebase
// Authentication is ingeschakeld.
//
// Uitgangspunten:
//   1. Niemand komt bij de gegevens zonder ingelogd schoolaccount.
//   2. Rollen staan in de database (/gebruikers/{email}), niet in de browser.
//   3. Een vakdocent kan alleen zijn eigen memo's schrijven.
//   4. Alles wat hier niet expliciet wordt toegestaan, is verboden.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- hulpfuncties ----------

    // Ingelogd met een geverifieerd schoolaccount van het Emmauscollege.
    function schoolAccount() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower().matches('.*@emmauscollege[.]nl');
    }

    function email() {
      return request.auth.token.email.lower();
    }

    // Het profiel dat de beheerder heeft klaargezet in /gebruikers/{email}.
    // Let op: elke aanroep is een extra document-read en telt mee in de Firestore-kosten.
    function heeftProfiel() {
      return schoolAccount()
          && exists(/databases/$(database)/documents/gebruikers/$(email()));
    }

    function rol() {
      return get(/databases/$(database)/documents/gebruikers/$(email())).data.rol;
    }

    function isSuperuser() {
      return heeftProfiel() && rol() == 'Superuser';
    }

    function isMentorOfHoger() {
      return heeftProfiel() && rol() in ['Mentor', 'Coordinator', 'Superuser'];
    }

    // ---------- wie mag er binnen ----------

    match /gebruikers/{gebruikerEmail} {
      // Je mag je eigen profiel lezen, zodat de app je rol kan ophalen.
      allow get: if schoolAccount() && gebruikerEmail == email();
      // De hele lijst opvragen en profielen beheren is voorbehouden aan de beheerder.
      allow list, write: if isSuperuser();
    }

    // ---------- stamgegevens ----------

    match /leerlingen/{doc} {
      allow read: if heeftProfiel();
      allow write: if isMentorOfHoger();
    }

    match /docentenVakken/{doc} {
      allow read: if heeftProfiel();
      allow write: if isMentorOfHoger();
    }

    // ---------- memo's ----------
    // Een docent maakt en wijzigt memo's op eigen naam.
    // Een mentor of hoger mag alle memo's inzien, aanpassen en verwijderen.

    match /memoTW1TW2/{doc} {
      allow read: if heeftProfiel();
      allow create: if heeftProfiel()
                    && (isMentorOfHoger() || request.resource.data.docentEmail.lower() == email());
      allow update: if isMentorOfHoger() || (
                      heeftProfiel()
                      && resource.data.docentEmail.lower() == email()
                      && request.resource.data.docentEmail.lower() == email()
                    );
      allow delete: if isMentorOfHoger();
    }

    match /memoTW3/{doc} {
      allow read: if heeftProfiel();
      allow create: if heeftProfiel()
                    && (isMentorOfHoger() || request.resource.data.docentEmail.lower() == email());
      allow update: if isMentorOfHoger() || (
                      heeftProfiel()
                      && resource.data.docentEmail.lower() == email()
                      && request.resource.data.docentEmail.lower() == email()
                    );
      allow delete: if isMentorOfHoger();
    }

    // ---------- mentorwerk ----------

    match /mentorVoorbereiding/{doc} {
      allow read: if heeftProfiel();
      allow write: if isMentorOfHoger();
    }

    match /voortgangsplan/{doc} {
      allow read: if heeftProfiel();
      allow write: if isMentorOfHoger();
    }

    match /classLocks/{doc} {
      allow read: if heeftProfiel();
      allow write: if isMentorOfHoger();
    }

    match /docentTaken/{doc} {
      allow read: if heeftProfiel();
      allow write: if isMentorOfHoger();
    }

    // ---------- toegangscodes ----------
    // Blijven alleen bestaan als je voor optie A uit BEVEILIGING.md kiest.
    // Bij optie B (inloggen met schoolaccount) kan deze collectie helemaal weg.

    match /codes/{doc} {
      allow read, write: if isSuperuser();
    }

    // ---------- sluitstuk ----------
    // Alles wat hierboven niet is toegestaan, is verboden.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
